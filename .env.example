# ===============================================================================
# DCC INSTITUTIONAL TRADING BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ===============================================================================
# Copy this file to '.env' and fill in your private API keys.
# Note: Account logins and broker passwords are stored in 'bot_accounts_config.json'.
# ===============================================================================

# [Optional] OpenRouter AI API Key (for LLM trade forensics & post-session analysis)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [Optional] OpenRouter Model ID (Default: deepseek/deepseek-chat or free models)
OPENROUTER_MODEL=

# [Optional] Google Drive Webhook URL (for automatic trade card & forensics cloud uploads)
# Can also be specified per-account in bot_accounts_config.json
GDRIVE_WEBHOOK_URL=

# [Optional] Strategy Version override: v1.0, v1.1, or v1.2 (Default: v1.2 ApexHunter Flagship)
DCC_VERSION=v1.2
